{
  "patches": {
    "contents/ui/ExpanderArrow.qml": [
      {
        "op": "replace",
        "old": "                tooltip.wasExpanded = systemTrayState.expanded;",
        "new": [
          "                tooltip.wasExpanded = systemTrayState.expanded && !hoverCloseTimer.hoverOpened;",
          "                hoverCloseTimer.hoverOpened = false;"
        ]
      },
      {
        "op": "insert_after",
        "anchor": [
          "    property bool wasExpanded",
          ""
        ],
        "text": [
          "",
          "    HoverHandler {",
          "        onHoveredChanged: {",
          "            hoverCloseTimer.arrowHovered = hovered;",
          "            hoverCloseTimer.sync();",
          "        }",
          "    }",
          ""
        ]
      }
    ],
    "contents/ui/main.qml": [
      {
        "op": "insert_before",
        "anchor": [
          "        Timer {",
          "            id: expandedSync",
          ""
        ],
        "text": [
          "        // Opens the popup on hover; closes it after a short delay so the pointer can reach it",
          "        Timer {",
          "            id: hoverCloseTimer",
          "            interval: 400",
          "            property bool hoverOpened: false",
          "            property bool arrowHovered: false",
          "            property bool popupHovered: false",
          "            function sync() {",
          "                if (arrowHovered || popupHovered) {",
          "                    stop();",
          "                    if (!systemTrayState.expanded) {",
          "                        hoverOpened = true;",
          "                        systemTrayState.expanded = true;",
          "                        expandedRepresentation.hiddenLayout.currentIndex = -1;",
          "                    }",
          "                } else if (hoverOpened) {",
          "                    restart();",
          "                }",
          "            }",
          "            onTriggered: {",
          "                if (hoverOpened && !arrowHovered && !popupHovered && !systemTrayState.activeApplet) {",
          "                    systemTrayState.expanded = false;",
          "                }",
          "                hoverOpened = false;",
          "            }",
          "        }",
          "",
          ""
        ]
      },
      {
        "op": "insert_after",
        "anchor": [
          "                id: expandedRepresentation",
          ""
        ],
        "text": [
          "",
          "                HoverHandler {",
          "                    onHoveredChanged: {",
          "                        hoverCloseTimer.popupHovered = hovered;",
          "                        hoverCloseTimer.sync();",
          "                    }",
          "                }",
          "",
          "                // Any click inside the popup keeps it open",
          "                TapHandler {",
          "                    acceptedButtons: Qt.AllButtons",
          "                    onPressedChanged: if (pressed) hoverCloseTimer.hoverOpened = false",
          "                }",
          ""
        ]
      }
    ]
  }
}
