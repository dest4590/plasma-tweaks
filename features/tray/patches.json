{
  "copy_from": [
    {
      "src": "contents/ui/CompactApplet.qml",
      "dst": "contents/applet/CompactApplet.qml"
    }
  ],
  "patches": {
    "contents/applet/CompactApplet.qml": [
      {
        "op": "replace",
        "old": "    mainText: plasmoidItem?.toolTipMainText ?? \"\"",
        "new": "    mainText: plasmoidItem ? plasmoidItem.toolTipMainText : \"\""
      },
      {
        "op": "replace",
        "old": "    subText: plasmoidItem?.toolTipSubText ?? \"\"",
        "new": "    subText: plasmoidItem ? plasmoidItem.toolTipSubText : \"\""
      },
      {
        "op": "replace",
        "old": "    location: if ((plasmoidItem?.parent as AbstractItem)?.inHiddenLayout && Plasmoid.location !== PlasmaCore.Types.LeftEdge) {",
        "new": "    location: plasmoidItem && plasmoidItem.parent && plasmoidItem.parent.inHiddenLayout && Plasmoid.location !== PlasmaCore.Types.LeftEdge ? PlasmaCore.Types.RightEdge : Plasmoid.location"
      },
      {
        "op": "replace",
        "old": [
          "        return PlasmaCore.Types.RightEdge;",
          "    } else {",
          "        return Plasmoid.location;",
          "    }"
        ],
        "new": ""
      },
      {
        "op": "replace",
        "old": "    textFormat: plasmoidItem?.toolTipTextFormat ?? Text.AutoText",
        "new": "    textFormat: plasmoidItem ? plasmoidItem.toolTipTextFormat : Text.AutoText"
      },
      {
        "op": "replace",
        "old": "    mainItem: plasmoidItem?.toolTipItem ?? null",
        "new": "    mainItem: plasmoidItem ? plasmoidItem.toolTipItem : null"
      },
      {
        "op": "replace",
        "old": "    property PlasmoidItem plasmoidItem",
        "new": "    property Item plasmoidItem"
      }
    ],
    "contents/ui/AbstractItem.qml": [
      {
        "op": "replace",
        "old": "            readonly property int size: abstractItem.inVisibleLayout ? root.itemSize : Kirigami.Units.iconSizes.medium",
        "new": "            readonly property int size: abstractItem.inVisibleLayout ? root.itemSize : Kirigami.Units.iconSizes.smallMedium"
      },
      {
        "op": "replace",
        "old": "            visible: abstractItem.inHiddenLayout",
        "new": "            visible: false"
      }
    ],
    "contents/ui/ExpandedRepresentation.qml": [
      {
        "op": "replace",
        "old": [
          "    Layout.minimumWidth: Kirigami.Units.gridUnit * 24",
          "    Layout.minimumHeight: Kirigami.Units.gridUnit * 24"
        ],
        "new": [
          "    readonly property int iconGridWidth: hiddenLayout.columns * hiddenLayout.cellWidth + Kirigami.Units.smallSpacing * 2",
          "    readonly property int iconGridHeight: Math.max(1, Math.ceil(hiddenLayout.count / hiddenLayout.columns)) * hiddenLayout.cellHeight + Kirigami.Units.smallSpacing * 2",
          "    implicitWidth: systemTrayState.activeApplet ? Kirigami.Units.gridUnit * 24 : iconGridWidth",
          "    implicitHeight: systemTrayState.activeApplet ? Kirigami.Units.gridUnit * 24 : iconGridHeight",
          "    Layout.minimumWidth: implicitWidth",
          "    Layout.preferredWidth: implicitWidth",
          "    Layout.maximumWidth: systemTrayState.activeApplet ? Infinity : iconGridWidth",
          "    Layout.minimumHeight: implicitHeight",
          "    Layout.preferredHeight: implicitHeight",
          "    Layout.maximumHeight: systemTrayState.activeApplet ? Infinity : iconGridHeight"
        ]
      },
      {
        "op": "replace",
        "old": "        height: trayHeading.height + bottomPadding + container.headingHeight",
        "new": [
          "        visible: !!systemTrayState.activeApplet",
          "        height: visible ? trayHeading.height + bottomPadding + container.headingHeight : 0"
        ]
      },
      {
        "op": "replace",
        "old": "        spacing: plasmoidHeading.bottomPadding",
        "new": "        spacing: systemTrayState.activeApplet ? plasmoidHeading.bottomPadding : 0"
      },
      {
        "op": "replace",
        "old": [
          "        RowLayout {",
          "            id: trayHeading"
        ],
        "new": [
          "        RowLayout {",
          "            id: trayHeading",
          "            visible: !!systemTrayState.activeApplet"
        ]
      },
      {
        "op": "replace",
        "old": [
          "                level: 1",
          "                text: systemTrayState.activeApplet"
        ],
        "new": [
          "                level: 1",
          "                visible: !!systemTrayState.activeApplet",
          "                text: systemTrayState.activeApplet"
        ]
      },
      {
        "op": "replace",
        "old": [
          "            Layout.fillHeight: true",
          "            Layout.topMargin: Kirigami.Units.smallSpacing",
          "            visible: !systemTrayState.activeApplet"
        ],
        "new": [
          "            Layout.fillHeight: true",
          "            Layout.topMargin: 0",
          "            visible: !systemTrayState.activeApplet"
        ]
      }
    ],
    "contents/ui/HiddenItemsView.qml": [
      {
        "op": "insert_after",
        "anchor": [
          "import QtQuick",
          ""
        ],
        "text": [
          "import QtQuick.Controls as QQC2",
          ""
        ]
      },
      {
        "op": "insert_after",
        "anchor": [
          "    background: null",
          ""
        ],
        "text": [
          "    padding: Kirigami.Units.smallSpacing",
          "    QQC2.ScrollBar.vertical.policy: QQC2.ScrollBar.AlwaysOff",
          "    QQC2.ScrollBar.horizontal.policy: QQC2.ScrollBar.AlwaysOff",
          ""
        ]
      },
      {
        "op": "replace",
        "old": "        readonly property int columns: 2",
        "new": "        readonly property int columns: Math.max(1, Math.min(6, Math.ceil(Math.sqrt(count))))"
      },
      {
        "op": "replace",
        "old": "        readonly property int delegateHeight: (metrics.height * delegateMaxTextLines) + (delegateMargins * 2)",
        "new": "        readonly property int delegateHeight: Kirigami.Units.iconSizes.smallMedium + Kirigami.Units.smallSpacing * 3"
      },
      {
        "op": "replace",
        "old": "        cellWidth: Math.floor(hiddenTasksView.availableWidth / columns)",
        "new": "        cellWidth: delegateHeight"
      },
      {
        "op": "replace",
        "old": "        currentIndex: -1",
        "new": [
          "        interactive: false",
          "        currentIndex: -1"
        ]
      },
      {
        "op": "replace",
        "old": "        readonly property int itemCount: model.count",
        "new": "        readonly property int itemCount: count"
      }
    ],
    "contents/ui/main.qml": [
      {
        "op": "replace",
        "old": [
          "                Layout.row: root.vertical && root.reverseLayout ? 1 : 0 // Explicitly define grid coordinates",
          "                Layout.column: 0                                        // to prevent overlapping"
        ],
        "new": [
          "                Layout.row: root.vertical && root.reverseLayout ? 1 : 0 // Explicitly define grid coordinates",
          "                Layout.column: root.vertical ? 0 : 1                     // icons follow the expand arrow"
        ]
      },
      {
        "op": "replace",
        "old": [
          "                Layout.row: root.vertical && !root.reverseLayout ? 1 : 0 // Explicitly define grid coordinates",
          "                Layout.column: root.vertical ? 0 : 1                     // to prevent overlapping"
        ],
        "new": [
          "                Layout.row: root.vertical && !root.reverseLayout ? 1 : 0 // Explicitly define grid coordinates",
          "                Layout.column: 0                                        // expand arrow precedes the icons"
        ]
      }
    ]
  }
}
