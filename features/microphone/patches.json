          "        }"
        ],
        "new": [
          "            muteItem.icon = \"audio-volume-muted\" + (Application.layoutDirection === Qt.RightToLeft ? \"-rtl\" : \"\");",
          "            menu.addMenuItem(muteItem, startNewInstanceItem);",
          "        }",
          "",
          "        if ((menu.visualParent as Task).hasMicStream) {",
          "            const muteMicItem = menu.newMenuItem(menu);",
          "            muteMicItem.checkable = true;",
          "            muteMicItem.checked = Qt.binding(() => {",
          "                return menu.visualParent && menu.visualParent.micMuted;",
          "            });",
          "            muteMicItem.clicked.connect(() => {",
          "                menu.visualParent.toggleMicMuted();",
          "            });",
          "            muteMicItem.text = i18nc(\"@option:check inmenu, no separate unmute action\", \"Mute Microphone\");",
          "            muteMicItem.icon = \"microphone-sensitivity-muted\";",
          "            menu.addMenuItem(muteMicItem, startNewInstanceItem);",
          "        }",
          "",
          "        if ((menu.visualParent as Task).hasAudioStream || (menu.visualParent as Task).hasMicStream) {",
          "            menu.addMenuItem(newSeparator(menu), startNewInstanceItem);",
          "        }"
        ]
      }
